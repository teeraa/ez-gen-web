# Internal URL of ez-gen-api (server-side only; never exposed to the browser)
API_URL=http://localhost:8080

# Public origin of this web app, used for absolute Open Graph URLs on /s/:token share pages.
# Must match ez-gen-api's PUBLIC_WEB_BASE_URL. Falls back to the request Host header when unset.
PUBLIC_WEB_BASE_URL=http://localhost:3000
